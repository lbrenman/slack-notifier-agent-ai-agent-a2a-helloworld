# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Slack Incoming Webhook URL
# Create at: https://api.slack.com/apps → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Optional ──────────────────────────────────────────────────────────────────

# Port this agent listens on (default: 3100)
# PORT=3100

# Claude model
# MODEL=claude-opus-4-5-20251101

# Public URL this agent is reachable at — used as the "url" field in the
# Agent Card so A2A Inspector (and other remote clients) know where to send
# JSON-RPC requests. In Codespaces this is your forwarded port's public URL,
# e.g. https://your-codespace-name-3100.app.github.dev
# PUBLIC_URL=http://localhost:3100
